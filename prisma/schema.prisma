generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TreatyStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum DrawdownStatus {
  PENDING
  REQUESTED
  CONFIRMED
  FAILED
}

enum AuditAction {
  TREATY_CREATED
  TREATY_UPDATED
  MONITOR_CHECK_RUN
  THRESHOLD_BREACH_DETECTED
  CAPITAL_REQUESTED
  CAPITAL_REQUEST_FAILED
  DRAWDOWN_CONFIRMED
  DRAWDOWN_CONFIRMATION_FAILED
  POOL_CREATED
  POOL_UPDATED
}

enum InvoiceStatus {
  PENDING_SME_SIGNATURE
  PENDING_BUYER_SIGNATURE
  VERIFIED
  REJECTED
}

enum InvoiceAuditAction {
  INVOICE_CREATED
  SME_SIGNATURE_VERIFIED
  SME_SIGNATURE_REJECTED
  BUYER_SIGNATURE_VERIFIED
  BUYER_SIGNATURE_REJECTED
  VERIFICATION_COMPLETED
  VERIFICATION_EXPIRED
  INVOICE_AUTO_IMPORTED
  INVOICE_SYNC_UPDATED
  INVOICE_SYNC_FLAGGED
}

// Stand-in for the on-chain pool-manager contract state until a real Soroban reader exists.
model Pool {
  id              String   @id @default(cuid())
  poolId          String   @unique
  totalCapital    Int
  utilisedCapital Int
  updatedAt       DateTime @updatedAt
}

// One row per Monte Carlo drawdown simulation run. The full loss
// distribution is stored as Json so the chart endpoint can re-bucket it
// without re-running the simulation; `trials` is typically 10k values,
// small enough for SQLite's Json column at this scaffold's scale.
model SimulationRun {
  id                      String   @id @default(cuid())
  poolId                  String?
  defaultRate             Float
  correlation             Float
  poolSize                Int
  feePct                  Float
  lossGivenDefault        Float
  trials                  Int
  confidenceLevel         Float
  seed                    Int
  valueAtRisk             Float
  conditionalValueAtRisk  Float
  maxDrawdown             Float
  lenderNetReturn         Float
  lossDistribution        Json
  createdAt               DateTime @default(now())

  @@index([poolId])
}

model Treaty {
  id               String   @id @default(cuid())
  poolId           String
  reinsurerName    String
  facilityLimit    Int
  triggerThreshold Float
  costBps          Int
  currency         String   @default("USD")
  status           TreatyStatus @default(ACTIVE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  drawdowns    CapitalDrawdown[]
  auditEntries FacilityAuditEntry[]

  @@index([poolId])
}

model CapitalDrawdown {
  id                 String         @id @default(cuid())
  treatyId           String
  treaty             Treaty         @relation(fields: [treatyId], references: [id])
  amountRequested    Int
  triggerReason      String
  status             DrawdownStatus @default(PENDING)
  reinsurerRequestId String?
  reinsurerResponse  Json?
  onChainTxHash      String?
  onChainConfirmedAt DateTime?
  failureReason      String?
  requestedAt        DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  auditEntries FacilityAuditEntry[]

  @@index([treatyId])
}

model FacilityAuditEntry {
  id         String      @id @default(cuid())
  action     AuditAction
  actor      String
  treatyId   String?
  treaty     Treaty?     @relation(fields: [treatyId], references: [id])
  drawdownId String?
  drawdown   CapitalDrawdown? @relation(fields: [drawdownId], references: [id])
  // Not an FK — Pool is keyed by its own poolId, and this lets pool audit
  // entries survive independent of whether the Pool row itself still exists.
  poolId     String?
  detail     Json
  createdAt  DateTime    @default(now())

  @@index([treatyId])
  @@index([drawdownId])
  @@index([poolId])
}

model Invoice {
  id                   String        @id @default(cuid())
  reference            String        @unique
  smeAddress           String
  buyerAddress         String
  // Which pool this invoice's financing draws from, if any. Nullable/loose
  // (no FK to Pool.poolId) because invoices can exist before a pool
  // assignment, and Pool rows are a stand-in for on-chain state.
  poolId               String?
  amount               Int
  currency             String        @default("USD")
  dueDate              DateTime
  invoiceHash          String
  status               InvoiceStatus @default(PENDING_SME_SIGNATURE)
  smeSignature         String?
  smeSignedAt          DateTime?
  buyerSignature       String?
  buyerSignedAt        DateTime?
  verificationDeadline DateTime?
  rejectionReason      String?
  verifiedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  auditEntries InvoiceAuditEntry[]

  @@index([status])
  @@index([verificationDeadline])
  @@index([poolId])
  @@index([buyerAddress])
  // Backs the duplicate-submission fingerprint check (buyer + amount + due
  // date) in createInvoice, so it's an indexed lookup rather than a scan.
  @@index([buyerAddress, amount, dueDate])
}

model InvoiceAuditEntry {
  id        String              @id @default(cuid())
  action    InvoiceAuditAction
  actor     String
  invoiceId String
  invoice   Invoice             @relation(fields: [invoiceId], references: [id])
  detail    Json
  createdAt DateTime            @default(now())

  @@index([invoiceId])
}

enum NotificationEventType {
  INVOICE_VERIFIED
  POOL_JOINED
  REPAYMENT_RECEIVED
  REPAYMENT_REMINDER
  DEFAULT_FLAGGED
}

enum EmailStatus {
  SENT
  FAILED
  BOUNCED
  SKIPPED_PREFERENCE
}

// Per-recipient opt-in/out for each notification event type, keyed by email
// address rather than a User id — this scaffold has no User model yet, and
// SMEs/lenders are otherwise identified by on-chain address, not email.
model NotificationPreference {
  id                String   @id @default(cuid())
  recipient         String   @unique
  invoiceVerified   Boolean  @default(true)
  poolJoined        Boolean  @default(true)
  repaymentReceived Boolean  @default(true)
  defaultFlagged    Boolean  @default(true)
  hasBounced        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EmailLog {
  id                String                @id @default(cuid())
  recipient         String
  eventType         NotificationEventType
  status            EmailStatus
  subject           String
  providerMessageId String?               @unique
  bounceReason      String?
  createdAt         DateTime              @default(now())

  @@index([recipient])
}

enum RegulatoryReportType {
  INVOICE_VOLUME
  DEFAULT_RATE
  POOL_UTILISATION
  WATERFALL_DISTRIBUTION
}

enum RegulatoryExportFormat {
  CSV
  JSON
  PDF
}

// One row per generated regulatory export. `content` holds the rendered
// report (text for CSV/JSON, base64 for PDF) alongside its signature, so a
// previously generated export can be re-served byte-for-byte rather than
// re-rendered (re-rendering could legitimately produce different bytes for
// the same period if new records arrived since, which would invalidate the
// original signature).
model RegulatoryExportRecord {
  id             String                  @id @default(cuid())
  reportType     RegulatoryReportType
  format         RegulatoryExportFormat
  periodStart    DateTime
  periodEnd      DateTime
  content        String
  contentHash    String
  signature      String
  signerPublicKey String
  generatedAt    DateTime                @default(now())

  @@index([reportType, periodStart])
}

enum KycStatus {
  VERIFIED
  EXPIRED
  REVOKED
}

// Only credential metadata is stored — subjectDid, issuer, validity window,
// and a hash of the credential for integrity/audit. The underlying KYC
// documents/PII a trusted provider checked are never sent to or stored by
// this backend; only the resulting verifiable credential is.
model KycCredential {
  id             String    @id @default(cuid())
  subjectDid     String
  subjectType    String
  issuerDid      String
  credentialId   String    @unique
  status         KycStatus @default(VERIFIED)
  issuedAt       DateTime
  expiresAt      DateTime
  verifiedAt     DateTime  @default(now())
  credentialHash String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([subjectDid])
}

// One row per reconciliation tick, comparing local DB aggregates against
// the (stubbed, until a real Soroban reader exists) on-chain ledger
// snapshot. `discrepancies` is empty on a clean run. See reconciliation.ts.
model ReconciliationRun {
  id             String   @id @default(cuid())
  dbSnapshot     Json
  chainSnapshot  Json
  discrepancies  Json
  healthy        Boolean
  ranAt          DateTime @default(now())

  @@index([healthy])
  @@index([ranAt])
}

enum AccountingProvider {
  XERO
  QUICKBOOKS
}

// One row per SME's connected accounting integration. Tokens are stored as
// received from the provider (this scaffold has no secrets-management
// integration yet) — see accountingIntegrationService.ts for the encrypt-at-
// rest follow-up note.
model AccountingConnection {
  id               String             @id @default(cuid())
  smeAddress       String
  provider         AccountingProvider
  externalTenantId String
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  connectedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([smeAddress, provider])
  @@index([provider])
}

// A registered external partner (accounting/ERP integrations, marketplace
// consumers, etc.) authenticating via API key rather than a Stellar address.
// Only the SHA-256 hash of the key is stored — the raw key is returned once,
// at registration, and cannot be retrieved again.
model Partner {
  id           String    @id @default(cuid())
  name         String
  contactEmail String
  apiKeyHash   String    @unique
  // Fast, non-secret lookup handle so verification doesn't have to hash and
  // compare every row: first 12 chars of the raw key, stored in the clear.
  apiKeyPrefix String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([apiKeyPrefix])
}
